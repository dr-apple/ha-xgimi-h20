{
  "config": {
    "step": {
      "user": {
        "title": "XGIMI H20",
        "description": "ADB must be enabled on the projector (Settings → System → Developer options → Network debugging). If Home Assistant's Android TV integration is already connected, its key is reused so no new approval is needed; otherwise confirm the prompt on the projector.",
        "data": {
          "host": "Host",
          "port": "ADB port",
          "adbkey": "ADB key file (relative to config)"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect. Is ADB enabled and the connection approved on the projector?"
    },
    "abort": {
      "already_configured": "Already configured",
      "not_supported": "Not an XGIMI H20"
    },
    "flow_title": "{name}"
  },
  "options": {
    "step": {
      "init": {
        "title": "XGIMI H20 options",
        "data": {
          "write_mode": "Write mode for picture settings",
          "scan_interval": "Polling interval",
          "snapshot_on_start": "Read picture menu after start"
        },
        "data_description": {
          "write_mode": "Persistent: the projector's picture menu is driven briefly (panel visible 3–20 s), the value is stored like a manual change. Live: written directly into the picture pipeline, invisible and instant, but lost on app/source change and not shown in the projector menu. Picture mode and settings without a native key always use the menu.",
          "snapshot_on_start": "Opens the picture menu once (about 30 s) when the projector is first seen awake, to read all values."
        }
      }
    }
  },
  "selector": {
    "write_mode": {
      "options": {
        "menu": "Persistent (via picture menu)",
        "live": "Live (invisible, not persistent)"
      }
    }
  },
