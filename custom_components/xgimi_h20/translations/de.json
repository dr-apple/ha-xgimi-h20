    "step": {
      "user": {
        "title": "XGIMI H20",
        "description": "Auf dem Beamer muss ADB aktiv sein (Einstellungen → System → Entwickleroptionen → Netzwerk-Debugging). Ist die Android-TV-Integration von Home Assistant bereits verbunden, wird deren Schlüssel genutzt – dann ist keine neue Freigabe nötig. Sonst die Abfrage am Beamer bestätigen.",
        "data": {
          "host": "Host",
          "port": "ADB-Port",
          "adbkey": "ADB-Schlüsseldatei (relativ zu config)"
        }
      }
    },
    "error": {
      "cannot_connect": "Keine Verbindung. Ist ADB aktiv und die Verbindung am Beamer erlaubt?"
    },
    "abort": {
      "already_configured": "Bereits eingerichtet",
      "not_supported": "Kein XGIMI H20"
    },
    "flow_title": "{name}"
  },
  "options": {
    "step": {
      "init": {
        "title": "XGIMI H20 Optionen",
        "data": {
          "write_mode": "Schreibmodus für Bildeinstellungen",
          "scan_interval": "Abfrageintervall",
          "snapshot_on_start": "Neue Bildprofile automatisch einlesen"
        },
        "data_description": {
          "write_mode": "Dauerhaft: Das Bildmenü des Beamers wird kurz automatisch bedient (Panel 3–20 s sichtbar), der Wert wird wie eine manuelle Änderung gespeichert. Live: direkt in die Bildpipeline geschrieben – unsichtbar und sofort, geht aber beim App-/Quellwechsel verloren und wird im Beamer-Menü nicht angezeigt. Bildmodus und Werte ohne nativen Schlüssel laufen immer über das Menü.",
          "snapshot_on_start": "Taucht eine Kombination aus Quelle, HDR-Typ und Bildmodus zum ersten Mal auf (z. B. der erste Dolby-Vision-Film), wird das Bildmenü einmal eingelesen (Panel ca. 30 s sichtbar). Danach kennt HA alle Werte dieses Profils."
        }
      }
    }
  },
